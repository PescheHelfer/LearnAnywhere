Debug 0

GenericExecuteSynth "{{HOME}}/.local/bin/piper_wrapper \"$DATA\" $VOICE $RATE"

GenericCmdDependency "piper_wrapper"

# Learn Anywhere's Speech rate slider sends SSIP RATE -100..100 (0 = normal).
# sd_generic normalizes that to -1.0..1.0 internally, then computes
# $RATE = speechd_rate*Multiply + Add - but Add/Multiply are parsed as
# INTEGERS ONLY (confirmed by probing: Multiply 0.5 silently truncates to 0,
# so no fractional slope is expressible here at all). Multiply 100 just
# reconstructs the original -100..100 scale losslessly; the actual
# fractional length_scale math happens in bin/piper_wrapper, in real
# floating point, not here. See README.md's Gotchas section.
GenericRateAdd          0
GenericRateMultiply     100
GenericRateForceInteger 1

GenericLanguage "en" "en_US" "utf-8"
GenericLanguage "en-us" "en_US" "utf-8"
GenericLanguage "en-GB" "en_GB" "utf-8"
GenericLanguage "en-gb" "en_GB" "utf-8"
GenericLanguage "de" "de_DE" "utf-8"
GenericLanguage "de-de" "de_DE" "utf-8"
GenericLanguage "it" "it_IT" "utf-8"
GenericLanguage "it-IT" "it_IT" "utf-8"
GenericLanguage "it-it" "it_IT" "utf-8"
GenericLanguage "fr" "fr_FR" "utf-8"
GenericLanguage "fr-FR" "fr_FR" "utf-8"
GenericLanguage "fr-fr" "fr_FR" "utf-8"

# British English preferred first, so it is the one offered as "Automatic".
# Edit this whole block to match whichever voices you actually downloaded —
# see ../voices.md. Every voice referenced here must exist in
# {{HOME}}/.local/share/piper/voices/, or sd_generic will log an error and
# the module may fail to start (it only needs ONE voice to succeed, so a
# missing file here does not take the whole module down, but that voice
# will not be offered).
AddVoice "en-GB" "MALE1"   "en_GB-alan-medium.onnx"
AddVoice "en-GB" "FEMALE1" "en_GB-jenny_dioco-medium.onnx"
AddVoice "en-US" "FEMALE1" "en_US-amy-medium.onnx"
