[Unit]
Description=Persistent audio player for Piper speech at %i Hz, reading raw PCM from the shared FIFO
Requires=piper-audio-holder@%i.service
After=piper-audio-holder@%i.service pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
# At login this unit starts in parallel with PipeWire/WirePlumber. pw-play then
# dies with "no target node available": either no sink exists yet, or WirePlumber
# reports one and then rebuilds its links a moment later. So wait (up to 30 s)
# until the default sink has resolved on 4 checks in a row (~2 s stable) before
# connecting (skipped when wpctl, from WirePlumber, is absent). Restart=always below remains the backstop if this still loses.
ExecStartPre=/bin/sh -c 'command -v wpctl >/dev/null || exit 0; ok=0; for i in $(seq 60); do if wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; then ok=$((ok+1)); [ $ok -ge 4 ] && exit 0; else ok=0; fi; sleep 0.5; done; exit 0'
# pw-play blocked reading the FIFO ignores SIGTERM, which made every restart
# (incl. restart-audio.sh) hang for systemd's 90 s default before SIGKILL.
KillSignal=SIGKILL
TimeoutStopSec=3
ExecStart=/bin/sh -c 'exec pw-play --rate=%i --channels=1 --format=s16 - < %t/piper_audio_%i.fifo'
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
