# Shortcut to the maintainer's local project archive (requirements history,
# feedback rounds, implementation prompts, build snapshots). Not part of the
# repository and deliberately not referenced from any tracked file. The
# directory form is defensive: if the shortcut is ever replaced by a junction,
# git must still refuse to descend into it.
/_archive.lnk
/_archive/

# Claude Code: personal/machine-specific settings and runtime state. Shared
# project config (settings.json, commands/, agents/, skills/) stays trackable,
# which is why this is not a blanket `.claude/` ignore. These rules live here
# rather than in a global ignore file so they hold on every machine.
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace

# Built Visual Studio Code Extensions
*.vsix

# Dart / Flutter
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
.pub-cache/
.pub/
pubspec_overrides.yaml

# Generated platform ephemeral / build output (all targets)
packages/*/windows/flutter/ephemeral/
packages/*/linux/flutter/ephemeral/
packages/*/macos/Flutter/ephemeral/
packages/*/android/.gradle/
packages/*/android/local.properties
packages/*/android/app/debug/
packages/*/android/app/profile/
packages/*/android/app/release/
packages/*/ios/Flutter/ephemeral/
packages/*/ios/Flutter/Generated.xcconfig
packages/*/ios/Flutter/flutter_export_environment.sh

# Symbolication / obfuscation output
app.*.symbols
app.*.map.json

# AppImage build staging and output — regenerated from packaging/linux/AppImageBuilder.yml,
# never committed. The built .AppImage is distributed as a GitHub Release asset instead.
/AppDir/
/appimage-build/
*.AppImage

# IDE metadata
.idea/
*.iml

# NOTE: `docs/` is tracked. It holds living developer reference only; project
# history (feedback, prompts, audits, screenshots) lives in the local archive
# above. Test fixtures belong under their own package's `test/fixtures/`, never
# in `docs/` — that is what the old `docs/*` + negation pair existed to work
# around, and why it is gone.
